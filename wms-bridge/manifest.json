{
  "manifest_version": 3,
  "name": "Hasaki WMS Token Bridge — Factory",
  "version": "1.4.0",
  "description": "Đưa token phiên của CHÍNH BẠN (WMS + work/hr) cho dashboard Factory và cho máy trạm đồng bộ (khỏi re-login đá phiên) — không đăng nhập lại, không tab ẩn. v1.4.0: nghe thêm wshr.hasaki.vn (work/hr) — vừa cấp token cho bộ 5S/chấm công, vừa là tín hiệu CÓ NGƯỜI ĐANG LÀM để máy trạm không đăng nhập đè.",
  "host_permissions": ["https://wms-gw.inshasaki.com/*", "https://wshr.hasaki.vn/*", "https://script.google.com/*", "https://script.googleusercontent.com/*"],
  "permissions": ["webRequest", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://letam0317.github.io/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://wms.inshasaki.com/*", "https://work.hasaki.vn/*", "https://hr.hasaki.vn/*"],
      "js": ["wms-main-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://wms.inshasaki.com/*", "https://work.hasaki.vn/*", "https://hr.hasaki.vn/*"],
      "js": ["wms-relay.js"],
      "run_at": "document_start"
    }
  ]
}
